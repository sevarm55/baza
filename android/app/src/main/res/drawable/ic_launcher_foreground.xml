<!--
  Знак приложения: лаймовая плашка с тёмной «Т».

  Плашка — та же, что в марке Tetrin: там в неё убраны последние две
  буквы, и именно она делает слово знаком. На иконке от слова остаётся
  только плашка и первая буква имени: «TETRIN» в 48 точках не читается
  ничем, а плашка узнаётся и в лотке приложений, и в шторке уведомлений.

  Рисунок в границах 108×108 с полем 18 по краям: система обрезает
  адаптивную иконку кругом, квадратом или каплей, и всё, что ближе к
  краю, у части устройств просто исчезнет.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M30,28 h48 a10,10 0 0 1 10,10 v32 a10,10 0 0 1 -10,10 h-48 a10,10 0 0 1 -10,-10 v-32 a10,10 0 0 1 10,-10 z"
        android:fillColor="#D7FF00" />

    <!-- «Т»: перекладина и ствол, теми же чернилами, что пишут по лайму -->
    <path
        android:pathData="M34,40 h40 v9 h-15.5 v19 h-9 v-19 h-15.5 z"
        android:fillColor="#2E1065" />
</vector>
