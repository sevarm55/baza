    "profile.devicesNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where your sign-in is open right now. You can close the others."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որտեղից է հիմա բացված ձեր մուտքը։ Կողքինը կարող եք փակել։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откуда сейчас открыт ваш вход. Чужой можно закрыть."
          }
        }
      }
    },
    "profile.devicesOne": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in is open only on this device."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտք բացված է միայն այս սարքից։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход открыт только с этого устройства."
          }
        }
      }
    },
    "profile.lockNote": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքի էկրանին կառաջարկվի մտնել որպես ինքներդ՝ առանց գաղտնաբառը նորից հավաքելու։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране входа предложим войти под собой, не набирая пароль заново."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the sign-in screen we will offer to sign you in as yourself, without typing the password again."
          }
        }
      }
    },
    "profile.passwordNote": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դրանով եք մտնում կաբինետ և հավելված։ Փոխելուց հետո բոլոր սարքերը դուրս կգան։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Им вы входите в кабинет и в приложение. После смены выйдут все устройства."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in to the cabinet and the app with it. Changing it signs out every device."
          }
        }
      }
    },
    "profile.pinChangedNote": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մյուս հեռախոսներից ելքը կփակվի։ Այս հեռախոսը կմնա բացված։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие телефоны выйдут. Этот телефон останется в аккаунте."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other phones sign out. This phone stays signed in."
          }
        }
      }
    },
    "profile.pinNote": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Թույլ է տալիս մտնել առանց SMS-ի։ Այս կոդն օգտագործվում է նաև հաշիվ արագ մտնելու համար։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет входить без SMS. Этот код также используется для быстрого входа в аккаунт."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you sign in without SMS. This code is also used for quick access to your account."
          }
        }
      }
    },
