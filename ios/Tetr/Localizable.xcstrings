    "expired.blocked": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Մուտքը ժամանակավորապես դադարեցված է։ Ձեր տվյալները տեղում են՝ գրանցումները, հասույթը, հաճախորդների բազան։ Ոչինչ չի կորել։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ временно приостановлен. Ваши данные на месте: записи, выручка, база клиентов. Ничего не потеряно."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is temporarily suspended. Your data is where it was: records, revenue, the client base. Nothing is lost."
          }
        }
      }
    },
