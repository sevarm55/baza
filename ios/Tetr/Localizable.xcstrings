    "auth.changePhoneNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your number is your sign-in. We will check it is you, then send a code to the new number."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Համարը ձեր մուտքն է։ Կստուգենք, որ դա դուք եք, ապա կուղարկենք կոդ նոր համարին։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номер — это ваш вход. Проверим, что это вы, и пришлём код на новый номер."
          }
        }
      }
    },
