    "crew.percentHint": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշված տոկոսը գործի արժեքից բաժանվում է բոլոր մասնակիցների միջև հավասար։ Սա ամբողջ թիմի տոկոսն է, ոչ թե յուրաքանչյուրինը։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Указанный процент от стоимости делится поровну между всеми участниками. Это процент на всю команду, а не каждому."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The percent is taken from the price and split equally between everyone involved. It is the percent for the whole team, not for each person."
          }
        }
      }
