          "stringUnit": {
            "state": "translated",
            "value": "Каждая машина записана"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every car logged"
          }
        }
      }
    },
    "onboarding.s2Body": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն մեքենայից՝ լվացողի տոկոսը։ Տոկոսը պահվում է գրանցման պահին, ուստի գների փոփոխությունը անցյալը չի փոխում։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С каждой машины идёт процент мойщика. Процент запоминается в момент записи, поэтому изменение цен прошлое не меняет."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The washer's percentage from every car. The percentage is stored at the moment of logging, so price changes do not rewrite the past."
          }
        }
      }
    },
    "onboarding.s2Title": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աշխատավարձը հաշվվում է ինքնաշխատ"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарплата считается сама"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payroll adds itself up"
          }
        }
      }
    },
    "onboarding.s3Body": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հասույթից հանվում են աշխատավարձը և ծախսերը՝ վարձ, քիմիա, հոսանք։ Մնացածը ձեր շահույթն է։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из выручки вычитаются зарплата и расходы: аренда, химия, электричество. Остальное ваша прибыль."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payroll and expenses come off the revenue: rent, chemicals, electricity. The rest is your profit."
          }
        }
      }
    },
    "onboarding.s3Title": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երևում է, թե որքան է մնում"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видно, сколько остаётся"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You see what is left"
          }
        }
      }
    },
    "onboarding.s4Body": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ներբեռնեք ամեն ինչ Excel-ով ցանկացած պահի։ Կապը կտրվե՞ց, գրանցումները սպասում են հեռախոսում և ուղարկվում իրենք։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачайте всё в Excel в любой момент. Пропала связь, записи ждут в телефоне и уходят сами."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download everything to Excel at any moment. Lost connection, records wait on the phone and send themselves."
          }
        }
      }
    },
