    "alerts.emptyNote": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անելիք չկա։ Երբ որևէ բան պահանջի ուշադրություն, կհայտնվի այստեղ։"
