    "setup.welcomeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust the prices and add your people. After that you can take in cars, and Tetrin will count payroll, costs and profit on its own."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուղղեք գները և ավելացրեք աշխատակիցներին։ Հետո կարող եք ընդունել մեքենաներ, իսկ աշխատավարձը, ծախսերն ու մաքուր եկամուտը Tetrin-ը կհաշվի ինքը։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поправьте цены и добавьте работников. После этого можно принимать машины, а зарплату, расходы и прибыль Tetrin посчитает сам."
          }
        }
      }
    },
