    "alerts.empty": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ամեն ինչ կարգին է"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё в порядке"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All good"
          }
        }
      }
    },
    "alerts.emptyNote": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Անելիք չկա։ Երբ որևէ բան պահանջի ուշադրություն, կհայտնվի այստեղ։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делать нечего. Когда что-то потребует внимания, оно появится здесь."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to do. When something needs attention, it shows up here."
          }
        }
      }
    },
