    "onboarding.s1Body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The washer logs it in three taps: plate, service, payment. You see it the same second."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Լվացողը գրանցում է երեք հպումով՝ համարանիշ, ծառայություն, վճարում։ Դուք տեսնում եք նույն վայրկյանին։"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мойщик записывает в три касания: номер, услуга, оплата. Вы видите в ту же секунду."
          }
        }
      }
    },
    "onboarding.s1Title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every car logged"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ամեն մեքենան՝ գրանցված"
