        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делать нечего. Когда что-то потребует внимания, оно появится здесь."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to do. When something needs attention, it shows up here."
          }
        }
      }
    },
