    "appearance.iconNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the icon for your home screen. Dark and tinted versions follow your phone settings."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք պատկերակը հիմնական էկրանի համար։ Մուգ և գունավորված տարբերակները հետևում են հեռախոսի կարգավորումներին։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите значок для домашнего экрана. Тёмный и подкрашенный виды система подставит сама."
          }
        }
      }
    },
