    "auth.pinNoneNote": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դուք մտնում եք SMS-ի կոդով։ PIN-ը երկրորդ դուռն է՝ երբ SMS-ը չի հասնում։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы входите по коду из SMS. PIN — вторая дверь, когда SMS не идёт."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sign in with an SMS code. A PIN is a second door for when SMS does not arrive."
          }
        }
      }
    },
    "auth.verifyPhoneWhy": {
      "extractionState": "manual",
      "localizations": {
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առանց հաստատված համարի PIN-ը վերականգնել հնարավոր չէ։ Կտևի կես րոպե։"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без подтверждённого номера восстановить PIN нельзя. Займёт полминуты."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a confirmed number your PIN cannot be recovered. Takes half a minute."
          }
        }
      }
    },
