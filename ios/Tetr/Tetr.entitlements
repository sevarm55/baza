<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- development: сборка из Xcode получает токен тестового контура Apple.
	     Перед отправкой в App Store Xcode подменяет значение на production
	     сам — руками менять не нужно. Серверу контур сообщает само
	     приложение полем sandbox, см. Core/Push.swift. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
